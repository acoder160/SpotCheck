# .easignore replaces .gitignore for EAS uploads, so the usual exclusions are repeated here.
# Native folders are regenerated by prebuild on EAS.
android/
ios/

node_modules/
.expo/
dist/
web-build/
.kotlin/
*.tsbuildinfo
npm-debug.*
.metro-health-check*

# Signing material never goes into the upload (EAS keeps the keys)
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
